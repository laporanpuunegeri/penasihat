    <style>
        /* Tetapan Asas */
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: #1a1a2e; 
            color: #ffffff;
        }
        .h-100 { height: 100vh !important; }
        .row.h-100 { min-height: 100vh; }

        /* --- BAHAGIAN KIRI (BRANDING AREA) --- */
        .left-panel {
            background: #1a1a2e; 
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Corak Litar Halus */
        .left-panel::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            opacity: 0.3;
            z-index: 1;
        }

        /* Logo Kontena */
        .logo-container { z-index: 2; margin-bottom: 30px; position: relative; }
        
        /* Gambar Logo (Perubahan Utama di sini) */
        .brand-logo {
            width: 180px; 
            height: 180px;
            object-fit: cover; 
            border-radius: 50%;
            background-color: #0f172a; 
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.4); 
            transition: transform 0.5s ease;
            /* Pastikan imej mempunyai latar belakang gelap */
            filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.3));
        }

        /* Jika anda menggunakan ikon Font Awesome dalam bulatan */
        .logo-icon-wrapper {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background-color: #0f172a;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.4);
            z-index: 2;
        }
        .logo-icon-wrapper i {
            font-size: 80px;
            color: #00ffff; /* Warna cyan/biru */
            text-shadow: 0 0 15px rgba(0, 255, 255, 0.8);
        }

        /* Teks Tajuk */
        .main-title { font-weight: 800; font-size: 3rem; letter-spacing: 2px; text-transform: uppercase; text-shadow: 0 4px 10px rgba(0,0,0,0.5); z-index: 2; margin-bottom: 5px; color: #e0f7fa; }
        .sub-title { font-size: 1.4rem; font-weight: 300; color: #a0aec0; z-index: 2; letter-spacing: 1px; }

        /* Badge Versi */
        .version-badge {
            background: rgba(0, 255, 255, 0.1); 
            border: 1px solid #00ffff;
            color: #00ffff;
            padding: 5px 20px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-top: 25px;
            z-index: 2;
            backdrop-filter: blur(5px);
        }

        /* --- BAHAGIAN KANAN (FORM LOGIN) --- */
        .right-panel {
            background: #24243e; 
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 40px;
        }

        /* Input Fields */
        .form-control {
            background-color: #33334d; 
            color: #ffffff; 
            border: 2px solid transparent;
            padding: 15px;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: all 0.3s;
        }
        .form-control::placeholder { color: #a0aec0; }
        .form-control:focus {
            background-color: #33334d;
            border-color: #00ffff; 
            box-shadow: 0 0 0 4px rgba(0, 255, 255, 0.1);
            color: #ffffff;
        }
        
        /* Form Label */
        .form-label { color: #cccccc !important; }
        
        /* Input Group Icon */
        .input-group-text {
            background-color: transparent !important;
            border-color: transparent !important;
            color: #00ffff !important; 
        }

        /* Login Button */
        .btn-login {
            background: linear-gradient(135deg, #00ffff 0%, #00bcd4 100%); 
            border: none;
            padding: 15px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 0.5px;
            box-shadow: 0 10px 20px rgba(0, 255, 255, 0.2);
            transition: transform 0.2s;
            color: #1a1a2e !important; 
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(0, 255, 255, 0.3);
            background: linear-gradient(135deg, #00e5e5 0%, #00aacc 100%);
        }

        /* Mobile Adjustments */
        @media (max-width: 768px) {
            .left-panel { min-height: 300px; }
            .main-title { font-size: 2rem; }
            .brand-logo, .logo-icon-wrapper { width: 100px; height: 100px; }
            .logo-icon-wrapper i { font-size: 40px; }
            .left-panel::before { display: none; } 
            .right-panel { background-color: #1a1a2e; } 
            .login-card { padding: 30px 10px; }
        }
    </style>
</head>
